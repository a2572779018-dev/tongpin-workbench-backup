{
  "name": "tongpin-workbench",
  "version": "0.1.49",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "同频：公司内部每日任务、账号审批、全员进度与桌面通知",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB,DESKTOP -c blue,cyan,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:api": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:desktop": "wait-on tcp:127.0.0.1:4318 tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 TONGPIN_API_URL=http://127.0.0.1:4318 electron .",
    "start:api": "cross-env NODE_ENV=development tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json --noEmit",
    "cloudflare:check": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run --outdir dist/cloudflare",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc --port 8787",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "release:verify": "npm run release:verify:win",
    "release:verify:win": "node scripts/publish-release.mjs --platform win --verify-only",
    "release:verify:mac": "node scripts/publish-release.mjs --platform mac --verify-only",
    "release:verify:remote": "npm run release:verify:remote:win",
    "release:verify:remote:win": "node scripts/verify-remote-release.mjs --platform win",
    "release:verify:remote:mac": "node scripts/verify-remote-release.mjs --platform mac",
    "release:upload": "node scripts/publish-release-bundle.mjs",
    "release:upload:win": "node scripts/publish-release.mjs --platform win --artifacts-only",
    "release:upload:mac": "node scripts/publish-release.mjs --platform mac --artifacts-only",
    "release:activate:win": "node scripts/publish-release.mjs --platform win --manifest-only",
    "release:activate:mac": "node scripts/publish-release.mjs --platform mac --manifest-only",
    "resend:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-resend.ps1",
    "test:cloudflare": "node scripts/verify-cloudflare.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vite build",
    "build:api": "tsup server/index.ts --format esm --out-dir dist/server --sourcemap",
    "build": "npm run typecheck && npm run test && npm run build:web && npm run build:api",
    "dist:win": "node scripts/verify-computer-use-runtime.cjs --source --target win32-x64 && npm run build && electron-builder --win nsis --publish never && node scripts/verify-asar-contents.cjs artifacts/win-unpacked/resources/app.asar --target win32-x64",
    "dist:mac": "node scripts/prepare-computer-use-runtime.cjs --target darwin-universal && node scripts/verify-computer-use-runtime.cjs --source --target darwin-universal && npm run build && node scripts/electron-builder-mac.cjs --mac dmg zip --universal --publish never && node scripts/verify-asar-contents.cjs artifacts/mac-universal/同频.app/Contents/Resources/app.asar --target darwin-universal",
    "start:desktop": "cross-env TONGPIN_API_URL=http://127.0.0.1:4318 electron ."
  },
  "build": {
    "appId": "com.tongpin.workbench",
    "productName": "同频",
    "asar": true,
    "asarUnpack": [
      "node_modules/@trycua/**/*",
      "node_modules/@ubjs/**/*"
    ],
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/entitlements.mac.plist",
      "build/entitlements.mac.inherit.plist",
      "THIRD_PARTY_NOTICES.md",
      "AI_DOCUMENT_LIBRARY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tongpin-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Tongpin-${version}-mac-${arch}.${ext}",
      "x64ArchFiles": "**/app.asar.unpacked/node_modules/@ubjs/node-darwin-{arm64,x64}/*.node",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "同频使用麦克风把你说的话转写成文字，发送给同频 AI。只在你按下麦克风按钮后录音。"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "同频",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://notify.samhubs.com/releases"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@formkit/auto-animate": "^0.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@trycua/cua-driver": "0.28.1",
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^1.27.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "metal-fx": "1.0.4",
    "micromark-extension-gfm": "3.0.0",
    "nodemailer": "9.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.18.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@webgpu/types": "^0.1.66",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "~11.11.2",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
