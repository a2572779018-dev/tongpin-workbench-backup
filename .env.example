# API
HOST=127.0.0.1
PORT=4318
DATA_FILE=.data/tongpin.json
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# 首位管理员。生产环境必须更换，并在首次登录后修改密码。
BOOTSTRAP_ADMIN_EMAIL=admin@company.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_NAME=系统管理员

# 邮件：推荐使用 Resend。API Key 只放在服务端环境变量，绝不能写进前端或 Electron。
RESEND_API_KEY=
RESEND_FROM=同频 <verify@notify.your-domain.com>

# 可选 SMTP 回退。配置 Resend 后会优先使用 Resend。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=同频 <no-reply@company.local>

# 仅供自动化测试或明确的本地调试；正常开发和生产环境都应保持 false。
DEV_EMAIL_PREVIEW=false

# LORA Chain 只读数据源。Renderer 不直接访问这些地址。
LORA_EXPLORER_API_URL=https://explorer.lorachain.org/api/v2
LORA_RPC_URL=https://explorer.lorachain.org/api/eth-rpc

# 桌面客户端构建时写入
VITE_API_URL=http://127.0.0.1:4318
